---
layout: null
---
[
  {% assign all_content = site.pages | concat: site.documents %}
  {% assign first_item = true %}

  {% for item in all_content %}
    {% if item.title and item.url contains '.html' %}
      {% unless first_item %},{% endunless %}
      {
        "title"       : {{ item.title | jsonify }},
        "year"        : {{ item.year | default: "" | jsonify }},
        "organization": {{ item.organization | default: "" | jsonify }},
        "category"    : {{ item.category | default: "" | jsonify }},
        "countries"   : {{ item.countries | default: "" | jsonify }},
        "keywords"    : {{ item.keywords | default: "" | jsonify }},
        "link"        : {{ item.link | default: "" | jsonify }},
        "content"     : {{ item.content | jsonify }}
      }
      {% assign first_item = false %}
    {% endif %}
  {% endfor %}
]
